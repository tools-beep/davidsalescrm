--
-- Name: eod_reports_with_users; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.eod_reports_with_users AS
 SELECT er.id,
    er.user_id,
    er.report_date,
    er.started_at,
    er.ended_at,
    er.total_minutes,
    er.summary,
    er.created_at,
    er.updated_at,
    concat(up.first_name, ' ', up.last_name) AS full_name,
    up.email,
    up.role
   FROM (public.eod_reports er
     LEFT JOIN public.user_profiles up ON ((er.user_id = up.user_id)));


ALTER VIEW public.eod_reports_with_users OWNER TO postgres;

